# Copy to scripts/test-e2e.env and customize for functional workflow tests.
# Loaded automatically by test-e2e-lib.sh

# ── Kind / compose URLs (908x = Kind, 808x = compose) ────────────────────────
# COMMANDER_URL=http://localhost:9081
# INVESTIGATOR_URL=http://localhost:9082
# ORCHESTRATOR_URL=http://localhost:9084
# AUTO_PORT_FORWARD=true

# ── Timeouts ─────────────────────────────────────────────────────────────────
WORKFLOW_RUN_TIMEOUT_SEC=120

# ── Live Git deploy (W15 — helm_deploy + Argo Application push) ──────────────
# Requires writable GitHub repos and cluster GitOps mirror.
E2E_ENABLE_LIVE_DEPLOY=false
# GITHUB_TOKEN=ghp_...
# GITOPS_REPO_URL=git@github.com:org/gitops.git
# E2E_HELM_DEPLOY_REPO=github.com/org/my-test-app

# ── Live CI / coding-agent (W16) ─────────────────────────────────────────────
E2E_ENABLE_GITHUB_CI=false
# E2E_GITHUB_REPO=github.com/org/my-app
# E2E_WORKFLOW_RUN_ID=123456789

# ── Fixture namespace for mutating tests ─────────────────────────────────────
# E2E_NS=sre-bot-e2e
